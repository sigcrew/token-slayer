{
  "name": "token-slayer",
  "productName": "Token Slayer",
  "version": "0.30.18",
  "description": "Claude / Codex 남은 사용량을 화면에 떠 있는 캐릭터로 보여주는 앱",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "dist:mac": "electron-builder --mac dmg zip -c.mac.identity=-",
    "dist:win": "electron-builder --win",
    "dist:mac:all": "electron-builder --mac dmg zip --arm64 --x64 -c.mac.identity=-",
    "prestart": "node scripts/build-packs.js",
    "predist:mac": "node scripts/build-packs.js",
    "predist:win": "node scripts/build-packs.js",
    "predist:mac:all": "node scripts/build-packs.js",
    "release:mac": "node scripts/build-packs.js && node scripts/release-mac.js",
    "release:win": "node scripts/build-packs.js && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.tokenslayer.app",
    "productName": "Token Slayer",
    "files": [
      "main.js",
      "preload.js",
      "preload-onboarding.js",
      "preload-scale.js",
      "preload-stats.js",
      "src/**",
      "renderer/**",
      "assets/**",
      "packs/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "extendInfo": {
        "LSUIElement": true
      },
      "artifactName": "TokenSlayer-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "TokenSlayer-Setup-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Token Slayer",
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": null,
    "portable": {
      "artifactName": "TokenSlayer-Portable-${version}-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sigcrew/token-slayer.git"
  }
}
